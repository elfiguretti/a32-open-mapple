Panfrost (Bifrost v7): fix overdraw_alpha inversion and RGB1 blend workaround.

1. Fix upstream Mesa 26.2.6 bug in panfrost_overdraw_alpha() (pan_cmdstream.h):
   !info.enabled was inverted and pan_cmdstream.c passed 0/1 swapped for
   overdraw_alpha0/overdraw_alpha1, causing opaque draws to advertise
   overdraw_alpha0 = true.
2. On PAN_ARCH >= 7, apply the RGB1->RGBA workaround uniformly while keeping
   fast hardware MALI_BLEND_MODE_OPAQUE for opaque draws.
diff --git a/src/gallium/drivers/panfrost/pan_cmdstream.c b/src/gallium/drivers/panfrost/pan_cmdstream.c
index bcb3abe..9626acf 100644
--- a/src/gallium/drivers/panfrost/pan_cmdstream.c
+++ b/src/gallium/drivers/panfrost/pan_cmdstream.c
@@ -396,8 +396,7 @@ panfrost_emit_blend(struct panfrost_batch *batch, void *rts,
             cfg.fixed_function.rt = i;
 
 #if PAN_ARCH >= 7
-            if (cfg.mode == MALI_BLEND_MODE_FIXED_FUNCTION &&
-                (cfg.fixed_function.conversion.memory_format & 0xff) ==
+            if ((cfg.fixed_function.conversion.memory_format & 0xff) ==
                    MALI_RGB_COMPONENT_ORDER_RGB1) {
                /* fixed function does not like RGB1 as the component order */
                /* force this field to be the default 0 (RGBA) */
@@ -595,8 +594,8 @@ panfrost_prepare_fs_state(struct panfrost_context *ctx, uint64_t *blend_shaders,
       cfg.properties.point_sprite_coord_origin_max_y =
          (rast->sprite_coord_mode == PIPE_SPRITE_COORD_LOWER_LEFT);
 
-      cfg.multisample_misc.overdraw_alpha0 = panfrost_overdraw_alpha(ctx, 0);
-      cfg.multisample_misc.overdraw_alpha1 = panfrost_overdraw_alpha(ctx, 1);
+      cfg.multisample_misc.overdraw_alpha0 = panfrost_overdraw_alpha(ctx, true);
+      cfg.multisample_misc.overdraw_alpha1 = panfrost_overdraw_alpha(ctx, false);
 #endif
 
       cfg.stencil_mask_misc.alpha_to_coverage = alpha_to_coverage;
diff --git a/src/gallium/drivers/panfrost/pan_cmdstream.h b/src/gallium/drivers/panfrost/pan_cmdstream.h
index 2c0f5aa..585d262 100644
--- a/src/gallium/drivers/panfrost/pan_cmdstream.h
+++ b/src/gallium/drivers/panfrost/pan_cmdstream.h
@@ -122,7 +122,7 @@ panfrost_overdraw_alpha(const struct panfrost_context *ctx, bool zero)
    for (unsigned i = 0; i < ctx->pipe_framebuffer.nr_cbufs; ++i) {
       const struct pan_blend_info info = so->info[i];
 
-      bool enabled = ctx->pipe_framebuffer.cbufs[i].texture && !info.enabled;
+      bool enabled = ctx->pipe_framebuffer.cbufs[i].texture && info.enabled;
       bool flag = zero ? info.alpha_zero_nop : info.alpha_one_store;
 
       if (enabled && !flag)
