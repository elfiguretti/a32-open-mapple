# Open Mapple fragment for Samsung Galaxy A32 4G (SM-A325M / a32).
CONFIG_DEVICE="a32"
# Keypad 0x10010000 bit 1 = Volume Up; MT6358 PMIC = Power + Volume Down (HOMEKEY).
CONFIG_BUTTONS=4
# Touch: STMicroelectronics FTS5CU56A (stm,stm_ts) on I2C6 (0x1100d000) @ 0x49, IRQ EINT 10.
CONFIG_TOUCH_STM_TS=y
# Storage: eMMC via MSDC0 (0x11230000) instead of UFS.
CONFIG_MTK_EMMC=y
